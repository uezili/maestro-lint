{
  "rules": {
    "metadata": {
      "validateAppId": true,
      "validateTags": false,
      "validateName": false,
      "validateNamePattern": true
    },
    "flows": {
      "validateOnFlowStart": true,
      "requireSetupInOnFlowStart": true,
      "validateOnFlowComplete": true,
      "requireTeardownInOnFlowComplete": true
    },
    "commands": {
      "validateCommandNames": true,
      "validateCommandProperties": true,
      "validateWhenConditions": true,
      "validateNestedCommands": true
    },
    "indentation": {
      "validateIndentation": true,
      "allowTabs": false,
      "indentSize": 2
    },
    "general": {
      "validateYamlSyntax": true,
      "validateDocumentStructure": true
    }
  },
  "severity": {
    "metadata": "error",
    "flows": "error",
    "commands": "error",
    "indentation": "error",
    "general": "error"
  }
}